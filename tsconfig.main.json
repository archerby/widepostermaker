{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": "./src",
    "outDir": "./dist",
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "isolatedModules": false,
    "types": ["node"]
  },
  "include": ["src/main/**/*", "scripts/**/*.ts"],
  "exclude": ["src/renderer", "dist", "node_modules"]
}
